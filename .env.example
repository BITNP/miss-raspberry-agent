# Copy this file to .env, fill in real values, and load it before running:
#   set -a; source .env; set +a
#
# NEVER commit the real .env.

# DeepSeek API key: https://platform.deepseek.com/api_keys
MODEL_API_KEY=sk-your-deepseek-api-key

# DeepSeek exposes an OpenAI-compatible endpoint.
MODEL_BASE_URL=https://api.deepseek.com/v1

# Model ID for fast testing; confirm the exact ID in your DeepSeek console
# if your account lists a different variant name.
MODEL_NAME=deepseek-v4-flash

# NapCat WebSocket connection (forward WS).
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=

# QQ account NapCat should quick-login automatically on startup, after the
# first QR login has been completed and the session is persisted in ./napcat/QQ.
# Leave empty to require a manual login/QR scan on every start.
#
# This value is interpolated into compose.yaml for the NapCat container. Keep it
# here (gitignored .env) — never put a real account number in a tracked file.
NAPCAT_QUICK_ACCOUNT=

# Inbound HTTP API server.
HTTP_ADDR=:4514

# Bearer token required by the HTTP API. Generate a long random value, e.g.:
#   openssl rand -hex 32
API_TOKEN=change-me
